{
  "name": "voiceify",
  "productName": "Voiceify",
  "version": "0.5.0",
  "description": "A private voice studio for your computer: text to speech, voice design and voice cloning with open-source AI models.",
  "keywords": [
    "text-to-speech",
    "tts",
    "voice-cloning",
    "voice-design",
    "qwen3-tts",
    "mlx",
    "apple-silicon",
    "electron",
    "mcp",
    "local-ai"
  ],
  "homepage": "https://github.com/iam-kanav/Voiceify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iam-kanav/Voiceify.git"
  },
  "bugs": {
    "url": "https://github.com/iam-kanav/Voiceify/issues"
  },
  "main": "out/main/index.js",
  "author": {
    "name": "Kanav Sethi",
    "url": "https://github.com/iam-kanav"
  },
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64",
    "dist:dir": "electron-vite build && electron-builder --mac --arm64 --dir",
    "mcp:stdio": "node resources/mcp/stdio-bridge.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=22"
  }
}
